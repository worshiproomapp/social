+// Which social post sent the person, from the tracked link they arrived on (labels we wrote, not data about them).
+// Anything that isn't a short lowercase label is dropped.
+function utmFields(a) {
+  const ok = (v) => (typeof v === 'string' && /^[a-z0-9_\-]{1,60}$/.test(v) ? v : null);
+  a = a && typeof a === 'object' ? a : {};
+  return [ok(a.source), ok(a.medium), ok(a.campaign), ok(a.content), ok(a.term)];
+}
+
+// The page the tracked link opened (a plain path), or null when there was no tracked link.
+function landingPath(a) {
+  const p = a && typeof a === 'object' ? a.landing : null;
+  return typeof p === 'string' && /^\/[a-z0-9\-\/]{0,100}$/.test(p) && utmFields(a)[0] ? p : null;
+}
+
+// Aggregate landing counter for tracked links: one row per day + labels, a number that goes up. No email,
+// IP, cookie or identifier is stored. Counts can be inflated by anyone who calls the endpoint, so read
+// them as directional, and compare with Cloudflare Web Analytics referrers.
+async function landing(request, env) {
+  if (request.method !== 'POST' || !isAllowedOrigin(request.headers.get('Origin'))) return new Response(null, { status: 204 });
+  let body = {};
+  try { body = JSON.parse(await request.text()); } catch { return new Response(null, { status: 204 }); }
+  const [source, medium, campaign, content, term] = utmFields(body);
+  const path = landingPath(body) || '/';
+  if (!source) return new Response(null, { status: 204 });
+  try {
+    await env.DB.prepare(
+      'INSERT INTO landings (day, path, utm_source, utm_medium, utm_campaign, utm_content, utm_term, visits) ' +
+      "VALUES (date('now'), ?1, ?2, ?3, ?4, ?5, ?6, 1) " +
+      'ON CONFLICT(day, path, utm_source, utm_medium, utm_campaign, utm_content, utm_term) DO UPDATE SET visits = visits + 1'
+    ).bind(path, source, medium || '', campaign || '', content || '', term || '').run();
+  } catch (err) {
+    console.error('landing_error', err && err.message);
+  }
+  return new Response(null, { status: 204 });
+}
