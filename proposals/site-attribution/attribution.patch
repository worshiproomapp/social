 const TURNSTILE_SITE_KEY = '0x4AAAAAAFxbAsn_hmHd0YC1';
 const TURNSTILE_TEST_KEY = '1x00000000000000000000BB'; // invisible, always passes
 const STORAGE_KEY = 'wr_waitlist_joined';
+const ATTR_KEY = 'wr_utm'; // sessionStorage only: gone when the tab closes. No cookie, nothing about the person.
+
+// First-touch attribution from a tracked social link (?utm_source=pinterest&utm_content=2026-12-pin-03…).
+// Keeps only short lowercase labels, then removes them from the address bar so shared links stay clean.
+const attribution = (() => {
+  const UTM = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
+  const params = new URLSearchParams(location.search);
+  const found = {};
+  for (const k of UTM) {
+    const v = (params.get(k) || '').toLowerCase();
+    if (/^[a-z0-9_\-]{1,60}$/.test(v)) found[k.slice(4)] = v;
+  }
+  let stored = null;
+  try { stored = JSON.parse(sessionStorage.getItem(ATTR_KEY) || 'null'); } catch { /* storage unavailable */ }
+  if (found.source && !stored) {
+    found.landing = location.pathname; // the page the tracked link opened
+    stored = found;
+    try { sessionStorage.setItem(ATTR_KEY, JSON.stringify(found)); } catch { /* ignore */ }
+    // One aggregate count per tracked landing (no email, no IP, no identifier). See /api/landing in the Worker.
+    try { navigator.sendBeacon('/api/landing', JSON.stringify(found)); } catch { /* ignore */ }
+  }
+  if (UTM.some((k) => params.has(k))) {
+    UTM.forEach((k) => params.delete(k));
+    const q = params.toString();
+    history.replaceState(history.state, '', location.pathname + (q ? '?' + q : '') + location.hash);
+  }
+  return stored;
+})();
 
